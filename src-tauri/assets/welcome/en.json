      "content": [
        {
          "type": "text",
          "text": "Small on purpose"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Novion runs on the macOS system WebView instead of bundling Chromium. The outline, version history, maths and image controls can each be switched off in Settings → Editor to trade features for memory."
        }
      ]
    },
