{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novion",
  "version": "0.0.1",
  "identifier": "app.novion.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novion",
        "width": 1320,
        "height": 880,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/Novion/**",
          "$DOCUMENT/Novion/assets/**",
          "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Novion/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Novion",
    "category": "Productivity",
    "shortDescription": "Local-first knowledge notes",
    "longDescription": "Novion is a lightweight, local-first knowledge notes client. Everything is stored as plain JSON files under ~/Documents/Novion.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}